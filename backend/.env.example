# ==============================================
# Backend Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values
# DO NOT commit the actual .env file to version control

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# Supabase (Recommended)
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# ==============================================
# API SERVER CONFIGURATION
# ==============================================

# Port the API server will listen on
API_PORT=8000

# CORS: Comma-separated list of allowed frontend URLs
# Development:
ALLOWED_ORIGINS=http://localhost:5173

# Production (add your deployed frontend URLs):
# ALLOWED_ORIGINS=https://yourdomain.com,https://stockscreener.vercel.app

# Optional: API Key for additional security
# If set, clients must include X-API-Key header
# API_KEY=your-optional-api-key

# ==============================================
# LOGGING
# ==============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==============================================
# RATE LIMITING
# ==============================================

# Maximum API requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# ==============================================
# QUICK START
# ==============================================

# 1. Copy this file: cp .env.example .env
# 2. Create Supabase project at supabase.com
# 3. Run database_schema.sql in Supabase SQL Editor
# 4. Copy SUPABASE_URL and SUPABASE_KEY from Settings → API
# 5. Paste them above
# 6. Save and run: python src/server.py
