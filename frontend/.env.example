# ==============================================
# Frontend Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values

# ==============================================
# API BACKEND URL
# ==============================================

# Development: Point to local backend
VITE_API_URL=http://localhost:8000

# Production: Uncomment and set your deployed backend URL
# VITE_API_URL=https://your-backend-api.com
# VITE_API_URL=https://stockscreener-api.railway.app
# VITE_API_URL=https://stockscreener-api.onrender.com

# ==============================================
# QUICK START
# ==============================================

# 1. Copy this file: cp .env.example .env
# 2. For local development, keep default VITE_API_URL
# 3. For production, uncomment and set your backend URL
# 4. Restart dev server: npm run dev
