# ==============================================
# Stock Screener Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values
# DO NOT commit the actual .env file to version control

# ==============================================
# DATABASE CONFIGURATION (Choose One Option)
# ==============================================

# ----------------
# Option A: Supabase (Recommended for Quick Start)
# ----------------
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# ----------------
# Option B: Custom PostgreSQL
# ----------------
# Uncomment and fill these if using your own PostgreSQL database
# See DATABASE_MIGRATION.md for setup instructions
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=stockscreener
# DB_USER=stockuser
# DB_PASSWORD=your_secure_password_here

# ==============================================
# API SERVER CONFIGURATION
# ==============================================

# Port the API server will listen on
API_PORT=8000

# CORS: Comma-separated list of allowed frontend URLs
# For local development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# For production, add your deployed frontend URLs:
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://stockscreener.vercel.app

# Optional: API Key for additional security
# If set, clients must include X-API-Key header with this value
# Leave empty or comment out to disable API key authentication
# API_KEY=your-optional-api-key-for-production

# ==============================================
# LOGGING CONFIGURATION
# ==============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==============================================
# RATE LIMITING
# ==============================================

# Maximum API requests per minute per IP address
RATE_LIMIT_PER_MINUTE=60

# ==============================================
# DATA FETCHING CONFIGURATION (Optional)
# ==============================================

# Markets to fetch (comma-separated)
# Available: US, TH, HK, JP, IN, VN, UK
# MARKETS=US,TH,HK,JP

# Schedule time for daily data fetching (24-hour format)
# FETCH_TIME=16:30

# ==============================================
# NOTIFICATION CONFIGURATION (Optional)
# ==============================================

# Slack webhook URL for notifications (optional)
# Get from: Slack → Apps → Incoming Webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email notifications (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# NOTIFICATION_EMAIL=admin@yourdomain.com

# ==============================================
# DEPLOYMENT CONFIGURATION (Optional)
# ==============================================

# For Railway deployment (auto-set by Railway)
# PORT=$PORT

# For Render deployment (auto-set by Render)
# RENDER=true

# Python version (for some deployment platforms)
# PYTHON_VERSION=3.10.0

# ==============================================
# MONITORING & ANALYTICS (Optional)
# ==============================================

# Sentry DSN for error tracking
# Get from: Sentry.io → Project Settings → Client Keys
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics ID (for frontend)
# GA_TRACKING_ID=G-XXXXXXXXXX

# ==============================================
# DEVELOPMENT SETTINGS
# ==============================================

# Set to 'development' for local dev, 'production' for deployed
ENVIRONMENT=development

# Enable debug mode (more verbose logging)
# DEBUG=false

# ==============================================
# NOTES
# ==============================================

# 1. SECURITY:
#    - Never commit the actual .env file to git
#    - Use strong, unique passwords
#    - Rotate API keys regularly
#    - Use environment-specific values for dev/staging/prod

# 2. DEPLOYMENT:
#    - Set environment variables in your hosting platform's dashboard
#    - For Railway: Settings → Variables
#    - For Render: Environment → Environment Variables
#    - For Vercel: Settings → Environment Variables
#    - For VPS: Create /etc/environment or use systemd EnvironmentFile

# 3. GITHUB ACTIONS:
#    - Add secrets in: Repository Settings → Secrets and variables → Actions
#    - Required secrets: SUPABASE_URL, SUPABASE_KEY (or DB_* variables)
#    - Optional: SLACK_WEBHOOK_URL for notifications

# 4. DATABASE:
#    - Supabase: Free tier includes 500MB storage
#    - PostgreSQL: Recommended version 12 or higher
#    - Connection pooling recommended for production (use PgBouncer)

# 5. TESTING:
#    - Create a separate .env.test file for testing
#    - Use a separate test database
#    - Never test with production data

# 6. TROUBLESHOOTING:
#    - Verify .env file is in src/api/ directory
#    - Check for typos in variable names
#    - Ensure no spaces around = signs
#    - Check that values don't have quotes (unless needed)
#    - Restart server after changing .env

# ==============================================
# QUICK START CHECKLIST
# ==============================================

# ✅ 1. Copy this file to .env (in same directory)
# ✅ 2. Choose database option (Supabase or PostgreSQL)
# ✅ 3. Fill in database credentials
# ✅ 4. Set ALLOWED_ORIGINS with your frontend URL
# ✅ 5. (Optional) Set API_KEY for security
# ✅ 6. Save and restart the server
# ✅ 7. Test with: python server.py

# For detailed setup instructions, see:
# - README.md - General setup
# - DATABASE_MIGRATION.md - Database setup
# - DEPLOYMENT.md - Production deployment
